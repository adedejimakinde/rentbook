# Copy to .env and fill in. Never commit .env.

# Django
# These defaults are for PRODUCTION. For local development only, change the two
# lines below to DJANGO_SETTINGS_MODULE=config.settings.dev and DEBUG=True.
# The dev settings refuse to start with DEBUG off, so they cannot serve real traffic.
DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=False
SECRET_KEY=change-me
ADMIN_URL=change-me-admin/
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
TIME_ZONE=America/Chicago

# Database and Redis (these hostnames match docker-compose.yml)
POSTGRES_DB=rentbook
POSTGRES_USER=rentbook
POSTGRES_PASSWORD=rentbook
DATABASE_URL=postgres://rentbook:rentbook@db:5432/rentbook
REDIS_URL=redis://redis:6379/0

# Bookings
BOOKING_BUFFER_DAYS=0
HOLD_MINUTES=15
ADMIN_HOLD_HOURS=48
# Hours' notice needed before the start of the event day for online quotes and bookings
MIN_NOTICE_HOURS=24

# Payments (Stripe keys from the Stripe dashboard; never commit real values)
STRIPE_SECRET_KEY=sk_test_change-me
STRIPE_PUBLISHABLE_KEY=pk_test_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me
DEPOSIT_PERCENT=50
ACH_HOLD_DAYS=7
# Hours a Zelle, Cash App or bank deposit booking stays held waiting for payment
MANUAL_PAY_HOLD_HOURS=24

# Manual payment details shown to customers (placeholders; fill in real values)
ZELLE_RECIPIENT=payments@example.com
ZELLE_NAME=Example Business LLC
CASHAPP_TAG=$ExampleBusiness
BANK_NAME=Example Bank
BANK_ACCOUNT_NAME=Example Business LLC
BANK_ACCOUNT_NUMBER=000000000
BANK_ROUTING_NUMBER=000000000

# Signed customer links: balance link lasts to the end of the event date or this
# many days, whichever is later; status link lasts STATUS_LINK_DAYS
BALANCE_LINK_DAYS=14
STATUS_LINK_DAYS=180

# Rental terms version recorded on each booking; change it when the terms change
TERMS_VERSION=2026-11-draft

# Error tracking (leave SENTRY_DSN empty to switch Sentry off)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# Pricing (SALES_TAX_RATE is a percent: 8.25 means 8.25%)
SALES_TAX_RATE=0
TAX_DELIVERY=False
TAX_SETUP=False

# Business details shown on the site
BUSINESS_NAME=Atglace Events & Rentals LLC
BUSINESS_TAGLINE=Your one-stop shop for event rentals
BUSINESS_AREA=DFW area
BUSINESS_PHONE=469-347-4687
BUSINESS_EMAIL=atglaceevents.rental@gmail.com
WHATSAPP_NUMBER=14693474687
# Optional social profile links shown in the footer (leave blank to hide)
SOCIAL_INSTAGRAM_URL=
SOCIAL_TIKTOK_URL=
SOCIAL_FACEBOOK_URL=

# Email: customer and owner emails go through Resend in production.
# DEFAULT_FROM_EMAIL must be on a domain verified in Resend.
DEFAULT_FROM_EMAIL=Atglace Events & Rentals <bookings@example.com>
RESEND_API_KEY=re_change-me
