# Copy to .env and fill in. Never commit .env.

# Django
SECRET_KEY=change-me
DEBUG=True
ADMIN_URL=change-me-admin/
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=America/Chicago
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database and Redis (these hostnames match docker-compose.yml)
POSTGRES_DB=rentbook
POSTGRES_USER=rentbook
POSTGRES_PASSWORD=rentbook
DATABASE_URL=postgres://rentbook:rentbook@db:5432/rentbook
REDIS_URL=redis://redis:6379/0

# Bookings
BOOKING_BUFFER_DAYS=0
HOLD_MINUTES=15

# Business details shown on the site
BUSINESS_NAME=Atglace Events & Rentals LLC
BUSINESS_TAGLINE=Your one-stop shop for event rentals
BUSINESS_AREA=DFW area
BUSINESS_PHONE=469-347-4687
BUSINESS_EMAIL=atglaceevents.rental@gmail.com
WHATSAPP_NUMBER=14693474687
